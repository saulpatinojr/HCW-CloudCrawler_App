# Cloud Crawler App edition: every environment variable the application reads, with no values.
# Copy to .env for a local run. Never commit a .env file; never put a client secret anywhere (edition.py refuses
# AZURE_CLIENT_SECRET, AZURE_CLIENT_CERTIFICATE_PATH, AZURE_CLIENT_CERTIFICATE_PASSWORD, AZURE_USERNAME and
# AZURE_PASSWORD at startup).

# Listening port inside the container (Container Apps ingress targets 8080).
PORT=8080

# Largest request body the MCP endpoint accepts, in bytes (default 5 MB).
CC_MAX_UPLOAD_BYTES=5242880

# Largest Resource Graph export the ingest accepts, in rows (default 5,000).
CC_MAX_ROWS=5000

# Default time to live of observed evidence, in hours.
CC_EVIDENCE_TTL_HOURS=24

# Host header values the MCP endpoint accepts (host or host:port, space or comma separated). Empty keeps the
# transport's loopback-only default; a deployment behind an ingress names its own public host name here.
CC_ALLOWED_HOSTS=

# The Azure MCP host. off: no Azure tool exists (the default). stdio: the development model, Azure MCP Server
# 3.0.0 started as a child process through npx with the developer's own credential chain (AZURE_TOKEN_CREDENTIALS
# is passed through; every other AZURE_* variable is not). recorded: replay the JSON recordings in a directory.
CC_AZMCP_MODE=off
CC_AZMCP_RECORDINGS=samples/azure-mcp

# 1 silences the content-free log writer (tests).
CC_LOG_SILENT=0
