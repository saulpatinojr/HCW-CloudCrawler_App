# Cloud Crawler App edition: every environment variable the application reads, with no values.
# Copy to .env for a local run. Never commit a .env file; never put a client secret anywhere (edition.py refuses
# AZURE_CLIENT_SECRET, AZURE_CLIENT_CERTIFICATE_PATH, AZURE_CLIENT_CERTIFICATE_PASSWORD, AZURE_USERNAME and
# AZURE_PASSWORD at startup).

# Listening port inside the container (Container Apps ingress targets 8080).
PORT=8080

# Largest request body the MCP endpoint accepts, in bytes (default 5 MB).
CC_MAX_UPLOAD_BYTES=5242880

# Largest Resource Graph export the ingest accepts, in rows (default 5,000).
CC_MAX_ROWS=5000

# Default time to live of observed evidence, in hours.
CC_EVIDENCE_TTL_HOURS=24

# Host header values the MCP endpoint accepts (host or host:port, space or comma separated). Empty keeps the
# transport's loopback-only default; a deployment behind an ingress names its own public host name here.
CC_ALLOWED_HOSTS=

# The Azure MCP host. off: no Azure tool exists (the default). stdio: the development model, Azure MCP Server
# 3.0.0 started as a child process through npx with the developer's own credential chain (AZURE_TOKEN_CREDENTIALS
# is passed through; every other AZURE_* variable is not). recorded: replay the JSON recordings in a directory.
CC_AZMCP_MODE=off
CC_AZMCP_RECORDINGS=samples/azure-mcp

# 1 silences the content-free log writer (tests).
CC_LOG_SILENT=0

# Sign-in for /api and /mcp (ADR 0004). off (the default): nothing asks for a token, which is for a trusted lab network
# only. entra: every route except /api/health needs a Microsoft Entra access token for this tenant and audience, and
# the human-only tools (adr_accept, review_decide, collection_run_azure) take the actor from the token's oid.
# With entra, the tenant and the audience are required, or the appliance refuses to start. These are identifiers, not
# secrets. With off, setting any CC_ENTRA_* variable is refused, so a half-finished setup cannot look protected.
CC_AUTH_MODE=off
# The directory (tenant) id, a GUID.
CC_ENTRA_TENANT_ID=
# Accepted `aud` values, space or comma separated: the Application ID URI and/or the client id of the API app
# registration (version 1.0 tokens carry the first, version 2.0 tokens the second).
CC_ENTRA_AUDIENCE=
# The delegated scope a token needs to call a human-only tool (default access_as_user).
CC_ENTRA_HUMAN_SCOPE=
# Clock skew allowed on exp and nbf, in seconds (default 60, at most 300).
CC_ENTRA_CLOCK_SKEW_SECONDS=
# How long signing keys are cached, in seconds (default 900, between 60 and 86400).
CC_ENTRA_JWKS_CACHE_SECONDS=

# The interface the server binds. Default 127.0.0.1 (this machine only); the container image sets 0.0.0.0.
CC_BIND_HOST=
