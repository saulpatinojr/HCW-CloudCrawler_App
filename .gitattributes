# Normalise line endings. PowerShell keeps CRLF so that Windows hosts run it unchanged.
* text=auto eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
