# Base image for every FROM in infrastructure/docker/Dockerfile: the same Docker Official Image pin the website and the
# Cloud Assessor pair use, python:3.14.8-slim-trixie (CPython 3.14.8 on Debian 13), by index digest. The tag beside the
# digest is documentation; Docker resolves the digest. Plain shell assignments, read by /bin/sh.
# [VERIFY] re-resolve the digest at the first image build (docker buildx imagetools inspect python:3.14.8-slim-trixie).
PYTHON_IMAGE=python:3.14.8-slim-trixie
PYTHON_IMAGE_DIGEST=sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
PYTHON_VERSION=3.14.8
